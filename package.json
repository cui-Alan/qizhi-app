{
  "name": "qizhi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && tsc -p electron/tsconfig.json && electron dist-electron/main.js\"",
    "electron:dist": "next build && tsc -p electron/tsconfig.json && electron-builder --mac dmg --dir",
    "electron:package": "next build && tsc -p electron/tsconfig.json && electron-builder --mac dmg"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/js-yaml": "^4.0.9",
    "@xstate/react": "^6.1.0",
    "@xyflow/react": "^12.11.1",
    "clsx": "^2.1.1",
    "js-yaml": "^5.2.0",
    "lucide-react": "^1.22.0",
    "monaco-editor": "^0.55.1",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "xstate": "^5.32.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.qizhi.app",
    "productName": "企智 QiZhi",
    "directories": { "output": "release" },
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "public/icon.icns"
    },
    "linux": { "target": ["AppImage"] }
  }
}
